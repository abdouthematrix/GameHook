<Window
    x:Class="GameHook.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GameHook Launcher"
    Width="720"
    Height="620"
    Background="{StaticResource BackgroundBrush}"
    FontFamily="Segoe UI"
    Icon="/neo_icon.ico"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  header  -->
            <RowDefinition Height="Auto" />
            <!--  MsgServer directory  -->
            <RowDefinition Height="Auto" />
            <!--  exe + args  -->
            <RowDefinition Height="Auto" />
            <!--  launch row  -->
            <RowDefinition Height="Auto" />
            <!--  log header  -->
            <RowDefinition Height="*" />
            <!--  log  -->
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,22"
            Orientation="Horizontal">
            <Border
                Width="10"
                Height="34"
                Margin="0,0,12,0"
                Background="{StaticResource AccentBrush}"
                CornerRadius="2" />
            <StackPanel>
                <TextBlock
                    FontFamily="Segoe UI Semibold"
                    FontSize="20"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="GameHook Launcher" />
                <TextBlock FontSize="12" Text="Starts the MsgServer and injects our modules" />
            </StackPanel>
        </StackPanel>

        <!--  Source directory  -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource LabelStyle}" Text="MsgServer DIRECTORY" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="MsgServerDirectoryTextBox"
                    Grid.Column="0"
                    Style="{StaticResource FieldTextBox}" />
                <Button
                    x:Name="BrowseButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Click="BrowseButton_Click"
                    Content="Browse..."
                    Style="{StaticResource SecondaryButton}" />
            </Grid>
        </StackPanel>

        <!--  Executable + arguments  -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource LabelStyle}" Text="MsgServer EXECUTABLE" />
                <TextBox x:Name="MsgServerExecutableTextBox" Style="{StaticResource FieldTextBox}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource LabelStyle}" Text="LAUNCH ARGUMENTS" />
                <TextBox x:Name="ArgumentsTextBox" Style="{StaticResource FieldTextBox}" />
            </StackPanel>
        </Grid>

        <!--  Launch row  -->
        <Grid Grid.Row="3" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="LaunchButton"
                Grid.Column="0"
                Width="160"
                Click="LaunchButton_Click"
                Content="Launch"
                Style="{StaticResource PrimaryButton}" />
            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="Ready." />
        </Grid>

        <!--  Log header  -->
        <TextBlock
            Grid.Row="4"
            Style="{StaticResource LabelStyle}"
            Text="LOG" />

        <!--  Log  -->
        <Border
            Grid.Row="5"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer
                x:Name="LogScrollViewer"
                Padding="10"
                VerticalScrollBarVisibility="Auto">
                <TextBox
                    x:Name="LogTextBox"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    IsReadOnly="True"
                    IsUndoEnabled="False"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
